{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "Buzzard",
    "ServiceNameSpace": "Buzzard",
    "ServiceVersion": "1.0.0",
    "Environment": "development",
    "OtlpEndpoint": "http://host.docker.internal:4317",
    "Headers": "",
    "IgnoredPaths": []
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "ClientIpHeader": "X-Test-Client-Ip",
    "KnownProxies": [],
    "KnownNetworks": ["172.16.0.0/12"],
    "DownstreamClientIpHeader": "X-Test-Downstream-Ip"
  },
  "ReverseProxy": {
    "Routes": {
      "localhost1": {
        "ClusterId": "localhost1",
        "Match": {
          "Hosts": ["localhost:5134"]
        }
      },
      "localhost2": {
        "ClusterId": "localhost2",
        "Match": {
          "Hosts": ["localhost:5135"]
        }
      }
    },
    "Clusters": {
      "localhost1": {
        "HttpClient": { "RequestHeaderEncoding": "utf-8" },
        "Destinations": {
          "front": {
            "Address": "http://host.docker.internal:3000/"
          }
        }
      },
      "localhost2": {
        "HttpClient": { "RequestHeaderEncoding": "utf-8" },
        "Destinations": {
          "backend": {
            "Address": "http://host.docker.internal:9001/"
          }
        }
      }
    }
  },
  "Firewall": {
    "Path": {
      "Allow": {
        "Contains": [
          "/status"
        ],
        "StartsWith": [
          "/api/public"
        ],
        "EndsWith": [
          ".css",
          ".js",
          ".png",
          ".ico"
        ]
      },
      "Deny": {
        "Contains": [
          "/admin",
          "/config",
          ".git",
          "../",
          "/.env"
        ],
        "StartsWith": [
          "/private/"
        ],
        "EndsWith": [
          ".bak",
          ".tmp",
          ".log"
        ]
      }
    },
    "UserAgent": {
      "Deny": {
        "Contains": [
          "bot"
        ],
        "StartsWith": [
          "evil/"
        ],
        "EndsWith": [
          "bad"
        ]
      },
      "ExemptPaths": [
        "/robots.txt"
      ]
    },
    "ClientBan": {
      "Mode": "Observe",
      "CountedStatusCodes": [403, 404],
      "Threshold": 20,
      "WindowSeconds": 10,
      "BanSeconds": 600,
      "MaxTrackedClients": 10000,
      "GlobalSafetyThreshold": 10,
      "GlobalSafetyWindowSeconds": 60,
      "ExemptNetworks": [],
      "RequestCount": {
        "Enabled": false,
        "Methods": ["GET", "HEAD"],
        "Extensions": [""],
        "ExcludedQueryKeys": ["_rsc"]
      }
    }
  }
}
